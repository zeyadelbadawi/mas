# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Everything is optional locally: without RESEND_API_KEY, form emails are printed to the terminal,
# and without TURNSTILE_SECRET_KEY the bot check is skipped (development only; production fails closed).

# Public URL of this site (used for canonical links and the form origin check). Vercel previews work without it.
NEXT_PUBLIC_SITE_URL=https://covy.mas.com

# Leave unset until launch. "true" lets search engines index the site (production only).
SITE_INDEXABLE=

# Forms → email (server only, never NEXT_PUBLIC_)
RESEND_API_KEY=
MAIL_FROM="COVY <reservations@send.mas.com>"
MAIL_TO=covy@mas.com

# Cloudflare Turnstile. These are Cloudflare's always-pass test keys; use the real pair on Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Analytics (this site's own GA4 property and Clarity project, created on the client's accounts)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Scroll-sequence frames on Cloudflare R2
NEXT_PUBLIC_MEDIA_URL=https://media.mas.com
