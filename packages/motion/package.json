  },
  "devDependencies": {
    "@mas/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
