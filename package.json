{
  "name": "mas-websites",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mas": "turbo run dev --filter=@mas/app-mas",
    "dev:covy": "turbo run dev --filter=@mas/app-covy",
    "dev:aroma": "turbo run dev --filter=@mas/app-aroma",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:manifest": "pnpm --filter @mas/tools assets:manifest",
    "placeholders:report": "pnpm --filter @mas/tools placeholders:report",
    "sequence:build": "pnpm --filter @mas/tools sequence:build",
    "sequence:test": "pnpm --filter @mas/tools sequence:test",
    "sequence:upload": "pnpm --filter @mas/tools sequence:upload"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "lighthouse": "13.5.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
